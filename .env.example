# Copie para .env com ./odonto.sh setup (ele gera as senhas e chaves que estiverem vazias).
# Formato: CHAVE=valor, sem aspas e sem comentários na mesma linha.
# NUNCA versione o .env. Guarde uma cópia das chaves fora do servidor: sem elas os dados
# cifrados (nomes, RG, mensagens, queixas) não podem ser lidos, nem a partir de um backup.

# --- Banco (o container monta a DATABASE_URL a partir destes valores) ---
DB_PASSWORD=
DB_NAME=odonto
DB_USER=odonto

# --- Chaves (32 bytes em Base64 cada; devem ser diferentes) ---
CHAVE_CRIPTOGRAFIA=
CHAVE_HMAC_DOCUMENTO=

# --- API da recepção (cabeçalho X-Admin-Token; 16+ caracteres) ---
ADMIN_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v24.0
WHATSAPP_TEMPLATE_NOVO_AGENDAMENTO=novo_agendamento
WHATSAPP_TEMPLATE_ALERTA=alerta_consultorio
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
# Celular da recepção que recebe os avisos (DDI+DDD+número, só dígitos, ex.: 5511999990000).
# Deve ser diferente do número do consultório usado pelo agente.
CONSULTORIO_WHATSAPP_NOTIFICACAO=

# --- IA: classificação da queixa e interpretação de datas (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_SEGUNDOS=30

# --- Transcrição de áudio (openai ou none) ---
TRANSCRICAO_PROVEDOR=openai
TRANSCRICAO_MODELO=gpt-transcribe
OPENAI_API_KEY=
OPENAI_TIMEOUT_SEGUNDOS=60

# --- E-mail para o consultório (habilitado quando SMTP_HOST e CONSULTORIO_EMAIL estão preenchidos) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
CONSULTORIO_EMAIL=

# --- Sistema ---
TZ=America/Sao_Paulo
LOG_NIVEL=INFO
# Porta publicada no host (dentro do container a aplicação usa sempre 8080).
PORTA=8080
# IPs dos proxies reversos confiáveis para X-Forwarded-For (ex.: 172.17.0.1 para o host Docker).
FORWARDED_ALLOW_IPS=127.0.0.1
